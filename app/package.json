{
  "name": "app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check --no-error-on-unmatched-pattern \"src/**/*.{ts,tsx,js,jsx,json,css}\" \"tests/**/*.{ts,tsx,js,jsx,json}\" \"*.{js,cjs,mjs,ts,json}\" \"../.github/**/*.{yml,yaml}\"",
    "test:unit": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:public": "playwright test --project=chromium tests/e2e/public-smoke.spec.ts",
    "task:contract": "python3 ../scripts/audit_tasks.py",
    "screen:contract": "python3 ../scripts/check_screen_contract.py",
    "validate": "python3 ../scripts/validate_inputs.py && npm run task:contract && npm run screen:contract",
    "ci": "npm run lint && npm run typecheck && npm run test:unit && npm run task:contract && python3 ../scripts/check_screen_contract.py --mode=ci && npm run build",
    "release:check": "npm run ci && npm run test:e2e"
  },
  "dependencies": {
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.8",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
